{
  "mcpServers": {
    "planka": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@omnicoreos/planka-mcp@0.3.0"
      ],
      "env": {
        "PLANKA_BASE_URL": "${user_config.planka_base_url}",
        "PLANKA_API_KEY": "${user_config.planka_api_key}",
        "PLANKA_DEFAULT_BOARD_ID": "${user_config.planka_default_board_id}"
      }
    }
  }
}
